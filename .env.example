ASE_DATABASE_URL=sqlite:///./var/ase.db
ASE_CHECKPOINT_BACKEND=auto
ASE_AGENT_READONLY_ROOT=false
ASE_REPOSITORY_LEASE_SECONDS=1800
ASE_API_KEY=dev-approval-key
ASE_WORKSPACE_ROOT=./var/workspaces
ASE_CODING_RUNTIME=openhands
ASE_LLM_PROVIDER=deepseek
ASE_LLM_MODEL=deepseek-flash
ASE_LLM_API_BASE=https://api.deepseek.com
ASE_LLM_API_KEY=
ASE_LLM_TEMPERATURE=0
ASE_LLM_MAX_TOKENS=4096
ASE_LLM_TIMEOUT=180
ASE_SANDBOX_IMAGE=python:3.12-slim
ASE_SANDBOX_MEMORY=512m
ASE_SANDBOX_CPUS=1.0
ASE_SANDBOX_NETWORK=none
ASE_AGENT_SERVER_NETWORK=bridge
ASE_AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.63.1-python
ASE_MAX_REPAIR_ATTEMPTS=2
